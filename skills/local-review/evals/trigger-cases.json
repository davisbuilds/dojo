          "local-review"
        ],
        "avoid": [
          "secure-code"
        ]
      }
    },
    {
      "id": "type-review",
      "type": "implicit",
      "prompt": "Review the types and invariants changed in this commit for reachable invalid states.",
      "expected": {
        "trigger": [
          "local-review"
        ],
        "avoid": [
          "api-design"
        ]
      }
    },
    {
      "id": "api-design",
      "type": "implicit",
      "prompt": "Design the HTTP API request and response schema, status codes and pagination.",
      "expected": {
        "trigger": [
          "api-design"
        ],
        "avoid": [
          "local-review"
        ]
      }
    },
    {
      "id": "security-scan",
      "type": "implicit",
      "prompt": "Run a semgrep security scan for vulnerabilities.",
      "expected": {
        "trigger": [
          "secure-code"
        ],
        "avoid": [
          "local-review"
        ]
      }
    }
  ]
