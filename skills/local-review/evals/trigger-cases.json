        "trigger": [
          "local-review"
        ],
        "avoid": [
          "api-design"
        ]
      }
    },
    {
      "id": "failure-review",
      "type": "implicit",
      "prompt": "Review error handling in this diff for swallowed errors, fallbacks and silent retry failures.",
